# Copy to .env and fill in. .env is gitignored. None of this is required to
# run the app — every source falls back to a synthetic fixture (see
# pipeline/utils.py) when its credentials aren't set.

# --- ACLED API (https://developer.acleddata.com) ---------------------------
ACLED_API_KEY=
ACLED_EMAIL=

# --- Google Earth Engine ---------------------------------------------------
# Register a Cloud project for Earth Engine, then either authenticate
# interactively (`earthengine authenticate`) or point to a service-account key.
# GEE_PROJECT is required by current Earth Engine at initialization.
GEE_PROJECT=
GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=

# --- PostgreSQL (backend; optional — DATA_BACKEND=parquet by default) ------
DATABASE_URL=postgresql://lights_out:lights_out@localhost:5432/lights_out
DATA_BACKEND=parquet
