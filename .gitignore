# ---------------------------------------------------------------------------
# Data — the small synthetic-fixture panels under data/ ARE committed (see
# data/README.md) so the app runs out of the box. A `MODE=live`/`MODE=local`
# pipeline run against the real, full-scale sources regenerates much larger
# files in data/processed/ — don't commit those; regenerate locally instead.
# ---------------------------------------------------------------------------
# The user's own raw ACLED + World Bank dump — never committed (keep the note).
data/raw/DataSet/*
!data/raw/DataSet/PLACE_DATASET_HERE.md

# Pipeline intermediates are build artifacts (regenerated by the ingest stages);
# only the 5 per-plot files in data/processed/ + data/geo/ are committed/served.
data/interim/*.parquet
data/interim/*.csv

# A GEE service-account key, if you drop one here.
data/raw/gee-key.json

# ---------------------------------------------------------------------------
# Secrets & credentials
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
service-account*.json
gee-credentials*.json
.acled_token

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
frontend/dist/
frontend/build/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------------
# Notebooks — keep the .ipynb but drop checkpoint/output cruft
# ---------------------------------------------------------------------------
notebooks/**/*-checkpoint.ipynb

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
logs/
